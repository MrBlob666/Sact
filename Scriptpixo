scrollFrame.BackgroundTransparency = 1
scrollFrame.BorderSizePixel = 0
scrollFrame.ScrollBarThickness = 3
scrollFrame.ScrollBarImageColor3 = C.primary
scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
scrollFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
scrollFrame.Parent = menuFrame
padding(scrollFrame, 5)

local listLayout = Instance.new("UIListLayout")
listLayout.Padding = UDim.new(0, 5)
listLayout.SortOrder = Enum.SortOrder.LayoutOrder
listLayout.Parent = scrollFrame

-- Creare sectiuni
local function createSection(title, buttons, order)
	local section = Instance.new("Frame")
	section.Name = title
	section.Size = UDim2.new(1, 0, 0, 0)
	section.AutomaticSize = Enum.AutomaticSize.Y
	section.BackgroundColor3 = C.bgSec
	section.BorderSizePixel = 0
	section.LayoutOrder = order
	section.Parent = scrollFrame
	corner(section, 5)
	stroke(section, Color3.fromRGB(55, 55, 75))
	padding(section, 4)

	local inner = Instance.new("UIListLayout")
	inner.Padding = UDim.new(0, 3)
	inner.Parent = section

	local header = Instance.new("TextLabel")
	header.Size = UDim2.new(1, 0, 0, 22)
	header.BackgroundColor3 = C.primary
	header.TextColor3 = C.text
	header.TextSize = 10
	header.Font = Enum.Font.GothamBold
	header.Text = string.upper(title)
	header.BorderSizePixel = 0
	header.LayoutOrder = 0
	header.Parent = section
	corner(header, 3)

	for i, data in ipairs(buttons) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, 0, 0, 26)
		btn.BackgroundColor3 = C.bgBtn
		btn.TextColor3 = C.text
		btn.TextSize = 11
		btn.Font = Enum.Font.Gotham
		btn.Text = data.name
		btn.BorderSizePixel = 0
		btn.AutoButtonColor = false
		btn.LayoutOrder = i
		btn.Parent = section
		corner(btn, 3)
		hover(btn, C.bgBtn, C.bgBtnHov)

		btn.MouseButton1Click:Connect(function()
			TweenService:Create(btn, TweenInfo.new(0.08), { BackgroundColor3 = C.primary }):Play()
			task.delay(0.15, function()
				TweenService:Create(btn, TW_FAST, { BackgroundColor3 = C.bgBtn }):Play()
			end)
			local ok, err = pcall(data.callback)
			if not ok then
				warn("[MinMenuGui] Eroare '" .. data.name .. "': " .. tostring(err))
			end
		end)
	end
end

